digraph "graph" {
layout=dot
rankdir=LR
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="a", fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label="x: E", fontcolor="black", color="black", shape="rect", tooltip="&'?4 mut i32"]
"r0" [label="x↓'?4", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut i32\
"]
    "p1" -> "r0" [label="bw0", tooltip="bw0: Default '?2", id="edge_0", color="orange", edgetooltip=""]
}

