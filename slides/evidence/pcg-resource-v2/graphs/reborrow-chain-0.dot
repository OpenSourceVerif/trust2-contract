digraph "graph" {
layout=dot
rankdir=LR
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="a", fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label="x: e", fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut i32"]
"p3" [label="y: e", fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"p4" [label="z: e", fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"r0" [label="old x↓'?6", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut i32\
"]
"p5" [label="*x", fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p6" [label="*y", fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r1" [label="old y↓'?7", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"r2" [label="old z↓'?8", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"p7" [label="*z: E", fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "p6" -> "r2" [label="bw2", tooltip="bw2: Default '?4", id="edge_0", color="orange", edgetooltip="", penwidth=3.5]
    "p6" -> "p7" [label="", id="edge_1", style="dashed", color="grey"]
    "p1" -> "p5" [label="", id="edge_2", style="dashed", color="grey"]
    "r1" -> "p6" [label="", id="edge_3", color="green", edgetooltip=""]
    "p5" -> "p6" [label="", id="edge_4", style="dashed", color="grey"]
    "r0" -> "p5" [label="", id="edge_5", color="green", edgetooltip=""]
    "p2" -> "p5" [label="", id="edge_6", color="green", edgetooltip=""]
    "p1" -> "r0" [label="bw0", tooltip="bw0: Default '?2", id="edge_7", color="orange", edgetooltip="", penwidth=3.5]
    "p3" -> "p6" [label="", id="edge_8", color="green", edgetooltip=""]
    "p4" -> "p7" [label="", id="edge_9", color="green", edgetooltip=""]
    "p5" -> "r1" [label="bw1", tooltip="bw1: Default '?3", id="edge_10", color="orange", edgetooltip="", penwidth=3.5]
    "r2" -> "p7" [label="", id="edge_11", color="green", edgetooltip=""]
}

