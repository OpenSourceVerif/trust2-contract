digraph "graph" {
layout=dot
rankdir=LR
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="a: E", fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p2" [label="x: E", fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut i32"]
"r0" [label="x↓'?6", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut i32\
"]
"p3" [label="y: W", fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p4" [label="z: W", fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut i32"]
}

