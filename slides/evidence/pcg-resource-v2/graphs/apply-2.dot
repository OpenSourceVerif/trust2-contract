digraph "graph" {
layout=dot
rankdir=LR
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="pt: E", fontcolor="black", color="black", shape="rect", tooltip="Point"]
"p2" [label="y: W", fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
}

