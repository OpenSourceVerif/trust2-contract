digraph "graph" {
layout=dot
rankdir=LR
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="pt", fontcolor="gray", color="gray", shape="rect", tooltip="Point"]
"p2" [label="y: E", fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"r0" [label="y↓'?7", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"r1" [label="old _3↓'?8", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"p3" [label="old (*_4)", fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"p4" [label="old _4", fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut Point"]
"r2" [label="old _4↓'?9", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut Point\
"]
    "p1" -> "r2" [label="bw0", tooltip="bw0: Default '?2", id="edge_0", color="orange", edgetooltip="", penwidth=3.5]
    "r1" -> "r0" [label="", id="edge_1", style="dashed", color="red", penwidth=3.5]
    "p4" -> "p3" [label="", id="edge_2", color="green", edgetooltip=""]
    "p1" -> "p3" [label="", id="edge_3", style="dashed", color="grey"]
    "p3" -> "r1" [label="bw1", tooltip="bw1: TwoPhaseBorrow '?3", id="edge_4", color="orange", edgetooltip="", penwidth=3.5]
    "r2" -> "p3" [label="", id="edge_5", color="green", edgetooltip=""]
}

