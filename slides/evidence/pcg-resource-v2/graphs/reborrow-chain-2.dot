digraph "graph" {
layout=dot
rankdir=LR
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="a", fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label="x: e", fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut i32"]
"p3" [label="y: E", fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"r0" [label="y↓'?7", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"p4" [label="z: W", fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut i32"]
"r1" [label="old x↓'?6", fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut i32\
"]
"p5" [label="*x: E", fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "p1" -> "p5" [label="", id="edge_0", style="dashed", color="grey"]
    "p1" -> "r1" [label="bw0", tooltip="bw0: Default '?2", id="edge_1", color="orange", edgetooltip="", penwidth=3.5]
    "p2" -> "p5" [label="", id="edge_2", color="green", edgetooltip=""]
    "r1" -> "p5" [label="", id="edge_3", color="green", edgetooltip=""]
}

