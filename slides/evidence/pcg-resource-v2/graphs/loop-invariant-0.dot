digraph "graph" {
layout=dot
rankdir=TB
ranksep=0.24
nodesep=0.18
node [fontsize=18, margin="0.07,0.04"]
edge [fontsize=13, arrowsize=0.8]
node [shape=rect]
"p0" [label="RETURN: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label="i: E", fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p2" [label="_2: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p3" [label="_3: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p4" [label="_4: W", fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p5" [label="_6: W", fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p6" [label="_7: W", fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p7" [label="_13: W", fontcolor="gray", color="gray", shape="rect", tooltip="(i32, bool)"]
"p8" [label="_14: W", fontcolor="gray", color="gray", shape="rect", tooltip="!"]
"p9" [label="_16: W", fontcolor="gray", color="gray", shape="rect", tooltip="!"]
}

