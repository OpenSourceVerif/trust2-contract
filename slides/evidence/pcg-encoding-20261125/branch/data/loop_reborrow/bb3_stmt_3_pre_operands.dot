digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">again: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="bool"]
"p2" [label=<<FONT FACE="courier">x</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p3" [label=<<FONT FACE="courier">r: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut i32"]
"p4" [label=<<FONT FACE="courier">_4: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p5" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p6" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p7" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p8" [label=<<FONT FACE="courier">_8: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"p9" [label=<<FONT FACE="courier">_9: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="!"]
"p10" [label=<<FONT FACE="courier">_11: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="!"]
"p11" [label=<<FONT FACE="courier">(*_8): E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r0" [label=<_8↓'?8 before bb3[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"p12" [label=<<FONT FACE="courier">*r</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r1" [label=<r↓'?6 before bb3[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut i32\
"]
    "r1" -> "p12" [label="", id="edge_0", color="green", edgetooltip="bb2 -> bb3"]
    "r0" -> "p11" [label="", id="edge_1", color="green", edgetooltip="bb2 -> bb3"]
    "p8" -> "p11" [label="", id="edge_2", color="green", edgetooltip="bb2 -> bb3"]
    "p12" -> "p11" [label="", id="edge_3", style="dashed", color="grey"]
    "p12" -> "r0" [label="bw1: Default '?3", id="edge_4", color="orange", edgetooltip="bb2 -> bb3"]
    "p3" -> "p12" [label="", id="edge_5", color="green", edgetooltip="bb2 -> bb3"]
    "p2" -> "r1" [label="loop at bb1[0]", id="edge_6", penwidth="3"]
}

