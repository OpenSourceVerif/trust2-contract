digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p1" [label=<<FONT FACE="courier">c</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="Container<'?8>"]
"p2" [label=<<FONT FACE="courier">c.x: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"r0" [label=<c.x↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"p3" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"r1" [label=<c↓'?8 before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="Container<'?8>\
"]
"r2" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="Container<'?8>\
"]
    "r2" -> "r1" [label="InitialBorrows", id="edge_0", color="purple"]
    "p1" -> "p2" [label="", id="edge_1"]
    "r1" -> "r0" [label="", id="edge_2", color="green", edgetooltip=""]
}

