digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"r0" [label=<RETURN↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"p1" [label=<<FONT FACE="courier">c</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="Container<'?8>"]
"p2" [label=<<FONT FACE="courier">c.x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"p3" [label=<<FONT FACE="courier">_2: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut i32"]
"r1" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="Container<'?8>\
"]
"r2" [label=<c↓'?8 before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="Container<'?8>\
"]
"p4" [label=<<FONT FACE="courier">(*_2)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p5" [label=<<FONT FACE="courier">*c.x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r3" [label=<c.x↓'?8 before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"r4" [label=<_2↓'?9 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut i32\
"]
    "p1" -> "p2" [label="", id="edge_0"]
    "p5" -> "p4" [label="", id="edge_1", style="dashed", color="grey"]
    "r3" -> "p5" [label="", id="edge_2", color="green", edgetooltip=""]
    "p3" -> "p4" [label="", id="edge_3", color="green", edgetooltip=""]
    "p5" -> "r4" [label="bw0: Default '?4", id="edge_4", color="orange", edgetooltip=""]
    "p4" -> "r0" [label="bw1: Default '?6", id="edge_5", color="orange", edgetooltip=""]
    "p2" -> "p5" [label="", id="edge_6", color="green", edgetooltip=""]
    "r1" -> "r2" [label="InitialBorrows", id="edge_7", color="purple"]
    "r4" -> "p4" [label="", id="edge_8", color="green", edgetooltip=""]
    "r2" -> "r3" [label="", id="edge_9", color="green", edgetooltip=""]
}

