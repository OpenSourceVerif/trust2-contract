digraph "graph" {
layout=dot
node [shape=rect]
"r0" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="Container<'?8>\
"]
"r1" [label=<c↓'?8 before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="Container<'?8>\
"]
"p0" [label=<<FONT FACE="courier">(*_2) before bb0[3]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p1" [label=<<FONT FACE="courier">_2 before bb0[3]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"r2" [label=<_2 before bb0[3]↓'?9 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut i32\
"]
"r3" [label=<RETURN↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"p2" [label=<<FONT FACE="courier">*c.x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p3" [label=<<FONT FACE="courier">c.x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"r4" [label=<c.x↓'?8 before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
    "p3" -> "p2" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "p0" [label="", id="edge_1", color="green", edgetooltip=""]
    "r1" -> "r4" [label="", id="edge_2", color="green", edgetooltip=""]
    "p2" -> "r2" [label="bw0: Default '?4", id="edge_3", color="orange", edgetooltip=""]
    "r4" -> "p2" [label="", id="edge_4", color="green", edgetooltip=""]
    "p0" -> "r3" [label="bw1: Default '?6", id="edge_5", color="orange", edgetooltip=""]
    "p2" -> "p0" [label="", id="edge_6", style="dashed", color="grey"]
    "r0" -> "r1" [label="InitialBorrows", id="edge_7", color="purple"]
    "r2" -> "p0" [label="", id="edge_8", color="green", edgetooltip=""]
}

