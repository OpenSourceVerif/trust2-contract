digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 mut i32"]
"p1" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut (i32, (i32, i32))"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"p4" [label=<<FONT FACE="courier">*x: E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="(i32, (i32, i32))"]
"r0" [label=<x↓'?7 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut (i32, (i32, i32))\
"]
"r1" [label=<Remote(_1)↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut (i32, (i32, i32))\
"]
    "p1" -> "p4" [label="", id="edge_0", color="green", edgetooltip=""]
    "r1" -> "r0" [label="InitialBorrows", id="edge_1", color="purple"]
    "r0" -> "p4" [label="", id="edge_2", color="green", edgetooltip=""]
}

