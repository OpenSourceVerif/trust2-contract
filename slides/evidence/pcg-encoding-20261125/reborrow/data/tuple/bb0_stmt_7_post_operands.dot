digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut i32"]
"r0" [label=<RETURN↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut i32\
"]
"p1" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut (i32, i32)"]
"p2" [label=<<FONT FACE="courier">(*_3) before bb0[5]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p3" [label=<<FONT FACE="courier">_3 before bb0[5]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"r1" [label=<_3 before bb0[5]↓'?9 before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut i32\
"]
"p4" [label=<<FONT FACE="courier">(*_2) before bb0[6]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p5" [label=<<FONT FACE="courier">(*x).0</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r2" [label=<Remote(_1)↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut (i32, i32)\
"]
"r3" [label=<x↓'?7 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut (i32, i32)\
"]
"p6" [label=<<FONT FACE="courier">_2 before bb0[6]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut i32"]
"r4" [label=<_2 before bb0[6]↓'?8 before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"p7" [label=<<FONT FACE="courier">*x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="(i32, i32)"]
"p8" [label=<<FONT FACE="courier">(*x).1: E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "p3" -> "p2" [label="", id="edge_0", color="green", edgetooltip=""]
    "p4" -> "r0" [label="bw2: Default '?5", id="edge_1", color="orange", edgetooltip=""]
    "p5" -> "r1" [label="bw0: Default '?3", id="edge_2", color="orange", edgetooltip=""]
    "r2" -> "r3" [label="InitialBorrows", id="edge_3", color="purple"]
    "p6" -> "p4" [label="", id="edge_4", color="green", edgetooltip=""]
    "r1" -> "p2" [label="", id="edge_5", color="green", edgetooltip=""]
    "r4" -> "p4" [label="", id="edge_6", color="green", edgetooltip=""]
    "p1" -> "p7" [label="", id="edge_7", color="green", edgetooltip=""]
    "r3" -> "p7" [label="", id="edge_8", color="green", edgetooltip=""]
    "p2" -> "r4" [label="bw1: Default '?4", id="edge_9", color="orange", edgetooltip=""]
    "p2" -> "p4" [label="", id="edge_10", style="dashed", color="grey"]
    "p7" -> "p5" [label="", id="edge_11", color="green", edgetooltip=""]
    "p5" -> "p2" [label="", id="edge_12", style="dashed", color="grey"]
    "p7" -> "p8" [label="", id="edge_13", color="green", edgetooltip=""]
}

