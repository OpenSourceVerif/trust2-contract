digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p1" [label=<<FONT FACE="courier">pt: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut Point"]
"p2" [label=<<FONT FACE="courier">_2: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?10 mut i32"]
"p4" [label=<<FONT FACE="courier">(*_3)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r0" [label=<_3↓'?10 before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?10 mut i32\
"]
"r1" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"r2" [label=<pt↓'?8 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"r3" [label=<_2↓'?9 before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut i32\
"]
"p5" [label=<<FONT FACE="courier">(*_2)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p6" [label=<<FONT FACE="courier">(*pt).x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p7" [label=<<FONT FACE="courier">*pt</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"p8" [label=<<FONT FACE="courier">(*pt).y: E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "r3" -> "p5" [label="", id="edge_0", color="green", edgetooltip=""]
    "r2" -> "p7" [label="", id="edge_1", color="green", edgetooltip=""]
    "p6" -> "r0" [label="bw0: Default '?4", id="edge_2", color="orange", edgetooltip=""]
    "p7" -> "p6" [label="", id="edge_3", color="green", edgetooltip=""]
    "p1" -> "p7" [label="", id="edge_4", color="green", edgetooltip=""]
    "r0" -> "p4" [label="", id="edge_5", color="green", edgetooltip=""]
    "p7" -> "p8" [label="", id="edge_6", color="green", edgetooltip=""]
    "p2" -> "p5" [label="", id="edge_7", color="green", edgetooltip=""]
    "p6" -> "p4" [label="", id="edge_8", style="dashed", color="grey"]
    "p4" -> "p5" [label="", id="edge_9", style="dashed", color="grey"]
    "p4" -> "r3" [label="bw1: Default '?5", id="edge_10", color="orange", edgetooltip=""]
    "p3" -> "p4" [label="", id="edge_11", color="green", edgetooltip=""]
    "r1" -> "r2" [label="InitialBorrows", id="edge_12", color="purple"]
}

