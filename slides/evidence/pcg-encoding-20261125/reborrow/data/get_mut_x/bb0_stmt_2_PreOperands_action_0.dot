digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p1" [label=<<FONT FACE="courier">pt: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut Point"]
"r0" [label=<pt↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?10 mut i32"]
"p4" [label=<<FONT FACE="courier">*pt</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"r1" [label=<pt↓'?8 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"r2" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
    "r2" -> "r0" [label="InitialBorrows", id="edge_0", color="purple"]
    "p1" -> "p4" [label="", id="edge_1", color="green", edgetooltip=""]
    "r1" -> "p4" [label="", id="edge_2", color="green", edgetooltip=""]
}

