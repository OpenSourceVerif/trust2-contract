digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p1" [label=<<FONT FACE="courier">pt: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut Point"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?10 mut i32"]
"r0" [label=<_3↓'?10>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?10 mut i32\
"]
"r1" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"r2" [label=<pt↓'?8 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"p4" [label=<<FONT FACE="courier">(*pt).x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p5" [label=<<FONT FACE="courier">*pt</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"p6" [label=<<FONT FACE="courier">(*pt).y: E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "r1" -> "r2" [label="InitialBorrows", id="edge_0", color="purple"]
    "p4" -> "r0" [label="bw0: Default '?4", id="edge_1", color="orange", edgetooltip=""]
    "p5" -> "p6" [label="", id="edge_2", color="green", edgetooltip=""]
    "p5" -> "p4" [label="", id="edge_3", color="green", edgetooltip=""]
    "r2" -> "p5" [label="", id="edge_4", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_5", color="green", edgetooltip=""]
}

