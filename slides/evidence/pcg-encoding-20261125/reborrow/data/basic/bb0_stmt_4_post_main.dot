digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"r0" [label=<RETURN↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"p1" [label=<<FONT FACE="courier">num: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"p2" [label=<<FONT FACE="courier">_2: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?10 mut i32"]
"p4" [label=<<FONT FACE="courier">(*_3)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r1" [label=<_3↓'?10 before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?10 mut i32\
"]
"p5" [label=<<FONT FACE="courier">(*_2)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r2" [label=<_2↓'?9 before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut i32\
"]
"p6" [label=<<FONT FACE="courier">*num</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r3" [label=<num↓'?8 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"r4" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
    "p4" -> "r2" [label="bw1: Default '?5", id="edge_0", color="orange", edgetooltip=""]
    "p4" -> "p5" [label="", id="edge_1", style="dashed", color="grey"]
    "p2" -> "p5" [label="", id="edge_2", color="green", edgetooltip=""]
    "p6" -> "r1" [label="bw0: Default '?4", id="edge_3", color="orange", edgetooltip=""]
    "p5" -> "r0" [label="bw2: Default '?6", id="edge_4", color="orange", edgetooltip=""]
    "r3" -> "p6" [label="", id="edge_5", color="green", edgetooltip=""]
    "p3" -> "p4" [label="", id="edge_6", color="green", edgetooltip=""]
    "r2" -> "p5" [label="", id="edge_7", color="green", edgetooltip=""]
    "p6" -> "p4" [label="", id="edge_8", style="dashed", color="grey"]
    "r4" -> "r3" [label="InitialBorrows", id="edge_9", color="purple"]
    "r1" -> "p4" [label="", id="edge_10", color="green", edgetooltip=""]
    "p1" -> "p6" [label="", id="edge_11", color="green", edgetooltip=""]
}

