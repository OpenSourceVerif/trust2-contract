digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p1" [label=<<FONT FACE="courier">num: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?10 mut i32"]
"p4" [label=<<FONT FACE="courier">(*_3): E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r0" [label=<_3↓'?10 before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?10 mut i32\
"]
"p5" [label=<<FONT FACE="courier">*num</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r1" [label=<num↓'?8 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"r2" [label=<Remote(_1)↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
    "r1" -> "p5" [label="", id="edge_0", color="green", edgetooltip=""]
    "p3" -> "p4" [label="", id="edge_1", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_2", color="green", edgetooltip=""]
    "p5" -> "r0" [label="bw0: Default '?4", id="edge_3", color="orange", edgetooltip=""]
    "p5" -> "p4" [label="", id="edge_4", style="dashed", color="grey"]
    "r0" -> "p4" [label="", id="edge_5", color="green", edgetooltip=""]
    "r2" -> "r1" [label="InitialBorrows", id="edge_6", color="purple"]
}

