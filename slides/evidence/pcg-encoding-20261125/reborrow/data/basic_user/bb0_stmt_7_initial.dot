digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p4" [label=<<FONT FACE="courier">_4: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"r0" [label=<_4↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_0", color="orange", edgetooltip=""]
}

