digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p3" [label=<<FONT FACE="courier">_3: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut Point"]
"r0" [label=<_3↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"p4" [label=<<FONT FACE="courier">_4: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut Point"]
"r1" [label=<_4↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut Point\
"]
"p5" [label=<<FONT FACE="courier">(*_4): R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"r2" [label=<_4↓'?9 before bb0[7]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut Point\
"]
    "r2" -> "p5" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_1", style="dashed", color="grey"]
    "p5" -> "r0" [label="bw1: TwoPhaseBorrow '?3", id="edge_2", color="orange", edgetooltip=""]
    "p1" -> "r2" [label="bw0: Default '?2", id="edge_3", color="orange", edgetooltip=""]
    "p4" -> "p5" [label="", id="edge_4", color="green", edgetooltip=""]
}

