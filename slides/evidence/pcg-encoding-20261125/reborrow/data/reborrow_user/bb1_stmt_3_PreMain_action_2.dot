digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">y: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"r0" [label=<y↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"r1" [label=<_3 before bb0[8]↓'?8 before bb0[8]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut Point\
"]
"p3" [label=<<FONT FACE="courier">(*_4) before bb1[2]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"p4" [label=<<FONT FACE="courier">_4 before bb1[2]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut Point"]
"r2" [label=<_4 before bb1[2]↓'?9 before bb0[7]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut Point\
"]
"p5" [label=<<FONT FACE="courier">*y</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r3" [label=<y↓'?7 before bb1[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
    "r1" -> "r0" [label="", id="edge_0", style="dashed", color="red"]
    "p3" -> "r1" [label="bw1: TwoPhaseBorrow '?3", id="edge_1", color="orange", edgetooltip=""]
    "r3" -> "p5" [label="", id="edge_2", color="green", edgetooltip=""]
    "p1" -> "r2" [label="bw0: Default '?2", id="edge_3", color="orange", edgetooltip=""]
    "r2" -> "p3" [label="", id="edge_4", color="green", edgetooltip=""]
    "p1" -> "p3" [label="", id="edge_5", style="dashed", color="grey"]
    "p4" -> "p3" [label="", id="edge_6", color="green", edgetooltip=""]
    "p2" -> "p5" [label="", id="edge_7", color="green", edgetooltip=""]
}

