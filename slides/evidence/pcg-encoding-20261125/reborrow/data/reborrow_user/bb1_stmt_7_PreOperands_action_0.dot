digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">pt.y: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p3" [label=<<FONT FACE="courier">pt.x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p4" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p5" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p6" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p7" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
    "p1" -> "p3" [label="", id="edge_0"]
    "p1" -> "p2" [label="", id="edge_1"]
}

