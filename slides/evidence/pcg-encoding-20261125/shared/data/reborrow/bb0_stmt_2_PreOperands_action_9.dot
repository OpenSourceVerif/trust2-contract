digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?5 mut U/#0"]
"p1" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut U/#0"]
"p2" [label=<<FONT FACE="courier">_2: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut U/#0"]
"r0" [label=<_2↓RegionsIn(U) before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut U/#0\
"]
"r1" [label=<(*_2)↓RegionsIn(U)>, fontcolor="blue", color="blue", shape="octagon", tooltip="U/#0\
"]
"r2" [label=<*x↓RegionsIn(U) before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="U/#0\
"]
"p3" [label=<<FONT FACE="courier">*x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="U/#0"]
"r3" [label=<_2↓'?7 before bb0[2]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut U/#0\
"]
"p4" [label=<<FONT FACE="courier">(*_2): E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="U/#0"]
"r4" [label=<Remote(_1)↓RegionsIn(U)>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut U/#0\
"]
"r5" [label=<x↓RegionsIn(U) before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut U/#0\
"]
"r6" [label=<Remote(_1)↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut U/#0\
"]
"r7" [label=<x↓'?6 before bb0[1]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut U/#0\
"]
"r8" [label=<_2↓RegionsIn(U) FUTURE>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut U/#0\
"]
    "r1" -> "r8" [label="Future", id="edge_0", color="purple"]
    "p3" -> "r3" [label="bw0: Default '?3", id="edge_1", color="orange", edgetooltip=""]
    "p2" -> "p4" [label="", id="edge_2", color="green", edgetooltip=""]
    "r7" -> "p3" [label="", id="edge_3", color="green", edgetooltip=""]
    "r5" -> "r2" [label="", id="edge_4", color="green", edgetooltip=""]
    "r0" -> "r8" [label="Future", id="edge_5", color="purple"]
    "r2" -> "r0" [label="equals", id="edge_6", color="purple", penwidth="2"]
    "r0" -> "r1" [label="", id="edge_7", color="green", edgetooltip=""]
    "p3" -> "p4" [label="", id="edge_8", style="dashed", color="grey"]
    "r4" -> "r5" [label="InitialBorrows", id="edge_9", color="purple"]
    "r6" -> "r7" [label="InitialBorrows", id="edge_10", color="purple"]
    "r3" -> "p4" [label="", id="edge_11", color="green", edgetooltip=""]
    "p1" -> "p3" [label="", id="edge_12", color="green", edgetooltip=""]
}

