digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 i32"]
"r0" [label=<x↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 i32\
"]
"p3" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p4" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p5" [label=<<FONT FACE="courier">_7: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"r1" [label=<_4 before bb1[2]↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 Point\
"]
    "p1" -> "r1" [label="bw0: shared '?2", id="edge_0", color="orange", edgetooltip=""]
}

