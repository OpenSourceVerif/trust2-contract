digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 i32"]
"r0" [label=<x↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 i32\
"]
"p3" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p4" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p5" [label=<<FONT FACE="courier">_7: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"r1" [label=<_3 before bb0[8]↓'?8 before bb0[8]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 Point\
"]
"p6" [label=<<FONT FACE="courier">(*_4) before bb1[2]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
"p7" [label=<<FONT FACE="courier">_4 before bb1[2]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 Point"]
"r2" [label=<_4 before bb1[2]↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 Point\
"]
    "p1" -> "p6" [label="", id="edge_0", style="dashed", color="grey"]
    "p6" -> "r1" [label="shared '?3", id="edge_1", color="orange", edgetooltip=""]
    "r1" -> "r0" [label="", id="edge_2", style="dashed", color="red"]
    "p1" -> "r2" [label="bw0: shared '?2", id="edge_3", color="orange", edgetooltip=""]
    "p7" -> "p6" [label="", id="edge_4", color="green", edgetooltip=""]
    "r2" -> "p6" [label="", id="edge_5", color="green", edgetooltip=""]
}

