digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">x: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 i32"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 Point"]
"p4" [label=<<FONT FACE="courier">_4: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 Point"]
"r0" [label=<_4↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 Point\
"]
    "p1" -> "r0" [label="bw0: shared '?2", id="edge_0", color="orange", edgetooltip=""]
}

