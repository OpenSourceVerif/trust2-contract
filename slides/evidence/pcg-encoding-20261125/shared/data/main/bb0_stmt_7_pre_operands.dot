digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">pt: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="Point"]
"p2" [label=<<FONT FACE="courier">x: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 i32"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 Point"]
"p4" [label=<<FONT FACE="courier">_4: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 Point"]
"r0" [label=<_4↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 Point\
"]
"p5" [label=<<FONT FACE="courier">(*_4): R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="Point"]
    "p1" -> "p5" [label="", id="edge_0", style="dashed", color="grey"]
    "p1" -> "r0" [label="bw0: shared '?2", id="edge_1", color="orange", edgetooltip=""]
    "p4" -> "p5" [label="", id="edge_2", color="green", edgetooltip=""]
    "r0" -> "p5" [label="", id="edge_3", color="green", edgetooltip=""]
}

