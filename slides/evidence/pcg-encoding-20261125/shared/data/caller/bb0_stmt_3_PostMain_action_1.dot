digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">v</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="T/#0"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?4 mut T/#0"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?5 mut T/#0"]
"p4" [label=<<FONT FACE="courier">_4: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut T/#0"]
"r0" [label=<_4↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r1" [label=<_4↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r2" [label=<v↓RegionsIn(T) before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r3" [label=<Remote(_1)↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
    "r3" -> "r2" [label="InitialBorrows", id="edge_0", color="purple"]
    "r2" -> "r0" [label="outlives", id="edge_1", style="dashed", color="purple"]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_2", color="orange", edgetooltip=""]
}

