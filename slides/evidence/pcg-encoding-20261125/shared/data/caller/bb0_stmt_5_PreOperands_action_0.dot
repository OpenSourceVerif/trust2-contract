digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">v</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="T/#0"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?4 mut T/#0"]
"p3" [label=<<FONT FACE="courier">_3: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?5 mut T/#0"]
"r0" [label=<_3↓'?5>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 mut T/#0\
"]
"r1" [label=<_3↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 mut T/#0\
"]
"p4" [label=<<FONT FACE="courier">_4: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut T/#0"]
"r2" [label=<_4↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r3" [label=<_4↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r4" [label=<(*_4)↓RegionsIn(T) before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r5" [label=<_4↓RegionsIn(T) before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r6" [label=<v↓RegionsIn(T) before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"p5" [label=<<FONT FACE="courier">(*_4): R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="T/#0"]
"r7" [label=<(*_4)↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r8" [label=<_4↓'?6 before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r9" [label=<(*_4)↓RegionsIn(T) FUTURE>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r10" [label=<_4↓RegionsIn(T) FUTURE>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r11" [label=<Remote(_1)↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
    "r6" -> "r8" [label="outlives", id="edge_0", style="dashed", color="purple"]
    "r8" -> "p5" [label="", id="edge_1", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_2", style="dashed", color="grey"]
    "r5" -> "r4" [label="", id="edge_3", color="green", edgetooltip=""]
    "r4" -> "r0" [label="outlives", id="edge_4", style="dashed", color="purple"]
    "p4" -> "p5" [label="", id="edge_5", color="green", edgetooltip=""]
    "r6" -> "r5" [label="equals", id="edge_6", color="purple", penwidth="2"]
    "r1" -> "r9" [label="Future", id="edge_7", color="purple"]
    "p1" -> "r8" [label="bw0: Default '?2", id="edge_8", color="orange", edgetooltip=""]
    "r11" -> "r6" [label="InitialBorrows", id="edge_9", color="purple"]
    "r4" -> "r1" [label="equals", id="edge_10", color="purple", penwidth="2"]
    "r9" -> "r10" [label="Future", id="edge_11", color="purple"]
    "r4" -> "r9" [label="Future", id="edge_12", color="purple"]
    "p5" -> "r0" [label="bw1: TwoPhaseBorrow '?3", id="edge_13", color="orange", edgetooltip=""]
}

