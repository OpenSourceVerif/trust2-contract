digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">v</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="T/#0"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?4 mut T/#0"]
"p3" [label=<<FONT FACE="courier">_4: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut T/#0"]
"r0" [label=<_4↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r1" [label=<_4↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r2" [label=<_4↓RegionsIn(T) before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r3" [label=<(*_4) before bb1[2]↓RegionsIn(T) before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r4" [label=<v↓RegionsIn(T) before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r5" [label=<_4↓'?6 before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r6" [label=<Remote(_1)↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
    "p1" -> "r5" [label="bw0: Default '?2", id="edge_0", color="orange", edgetooltip=""]
    "r6" -> "r4" [label="InitialBorrows", id="edge_1", color="purple"]
    "r2" -> "r3" [label="", id="edge_2", color="green", edgetooltip=""]
    "r4" -> "r5" [label="outlives", id="edge_3", style="dashed", color="purple"]
    "r4" -> "r2" [label="equals", id="edge_4", color="purple", penwidth="2"]
}

