digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">v</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="T/#0"]
"p2" [label=<<FONT FACE="courier">_2: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?4 mut T/#0"]
"r0" [label=<_2↓'?4>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut T/#0\
"]
"r1" [label=<_2↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut T/#0\
"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?5 mut T/#0"]
"p4" [label=<<FONT FACE="courier">_4: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut T/#0"]
"r2" [label=<_4↓RegionsIn(T) before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r3" [label=<(*_4)↓RegionsIn(T) before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r4" [label=<v↓RegionsIn(T) before bb0[3]>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
"r5" [label=<_3 before bb0[5]↓'?5 before bb0[5]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 mut T/#0\
"]
"p5" [label=<<FONT FACE="courier">(*_4)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="T/#0"]
"r6" [label=<_4↓'?6 before bb0[4]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T/#0\
"]
"r7" [label=<_3 before bb0[5]↓RegionsIn(T) before bb0[5]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 mut T/#0\
"]
"r8" [label=<Remote(_1)↓RegionsIn(T)>, fontcolor="blue", color="blue", shape="octagon", tooltip="T/#0\
"]
    "r3" -> "r5" [label="outlives", id="edge_0", style="dashed", color="purple"]
    "r6" -> "p5" [label="", id="edge_1", color="green", edgetooltip=""]
    "p5" -> "r5" [label="bw1: TwoPhaseBorrow '?3", id="edge_2", color="orange", edgetooltip=""]
    "r4" -> "r6" [label="outlives", id="edge_3", style="dashed", color="purple"]
    "r3" -> "r7" [label="equals", id="edge_4", color="purple", penwidth="2"]
    "p1" -> "r6" [label="bw0: Default '?2", id="edge_5", color="orange", edgetooltip=""]
    "r2" -> "r3" [label="", id="edge_6", color="green", edgetooltip=""]
    "p4" -> "p5" [label="", id="edge_7", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_8", style="dashed", color="grey"]
    "r4" -> "r2" [label="equals", id="edge_9", color="purple", penwidth="2"]
    "r8" -> "r4" [label="InitialBorrows", id="edge_10", color="purple"]
}

