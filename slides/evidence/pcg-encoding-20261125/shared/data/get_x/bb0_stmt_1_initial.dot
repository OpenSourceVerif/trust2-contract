digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 i32"]
"p1" [label=<<FONT FACE="courier">pt: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 Point"]
"r0" [label=<pt↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 Point\
"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 i32"]
"r1" [label=<Remote(_1)↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 Point\
"]
    "r1" -> "r0" [label="InitialBorrows", id="edge_0", color="purple"]
}

