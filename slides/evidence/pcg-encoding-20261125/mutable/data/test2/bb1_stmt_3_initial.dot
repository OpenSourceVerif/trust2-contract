digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p2" [label=<<FONT FACE="courier">x: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 mut i32"]
"p3" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p4" [label=<<FONT FACE="courier">z: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut i32"]
"p5" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="()"]
}

