digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut i32"]
"p3" [label=<<FONT FACE="courier">y: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut i32"]
"p4" [label=<<FONT FACE="courier">z: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut i32"]
"r0" [label=<x↓'?6 before bb0[7]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut i32\
"]
"p5" [label=<<FONT FACE="courier">*x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p6" [label=<<FONT FACE="courier">*y</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r1" [label=<y↓'?7 before bb0[10]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut i32\
"]
"r2" [label=<z↓'?8 before bb0[12]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut i32\
"]
"p7" [label=<<FONT FACE="courier">*z: E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "p6" -> "p7" [label="", id="edge_0", style="dashed", color="grey"]
    "p5" -> "p6" [label="", id="edge_1", style="dashed", color="grey"]
    "p4" -> "p7" [label="", id="edge_2", color="green", edgetooltip=""]
    "p2" -> "p5" [label="", id="edge_3", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_4", style="dashed", color="grey"]
    "r1" -> "p6" [label="", id="edge_5", color="green", edgetooltip=""]
    "r0" -> "p5" [label="", id="edge_6", color="green", edgetooltip=""]
    "p3" -> "p6" [label="", id="edge_7", color="green", edgetooltip=""]
    "r2" -> "p7" [label="", id="edge_8", color="green", edgetooltip=""]
    "p5" -> "r1" [label="bw1: Default '?3", id="edge_9", color="orange", edgetooltip=""]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_10", color="orange", edgetooltip=""]
    "p6" -> "r2" [label="bw2: Default '?4", id="edge_11", color="orange", edgetooltip=""]
}

