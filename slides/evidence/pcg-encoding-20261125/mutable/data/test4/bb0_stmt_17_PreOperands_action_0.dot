digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="T"]
"p2" [label=<<FONT FACE="courier">x: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 mut T"]
"p3" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut u32"]
"p4" [label=<<FONT FACE="courier">z: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut u32"]
"p5" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p6" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p7" [label=<<FONT FACE="courier">_7: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="u32"]
}

