digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="T"]
"p2" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 mut T"]
"p3" [label=<<FONT FACE="courier">y: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 mut u32"]
"p4" [label=<<FONT FACE="courier">z: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut u32"]
"r0" [label=<z↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut u32\
"]
"r1" [label=<x↓'?6 before bb0[7]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 mut T\
"]
"p5" [label=<<FONT FACE="courier">*x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="T"]
"p6" [label=<<FONT FACE="courier">(*x).f</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
"r2" [label=<y↓'?7 before bb0[10]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut u32\
"]
"p7" [label=<<FONT FACE="courier">*y</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
    "p2" -> "p5" [label="", id="edge_0", color="green", edgetooltip=""]
    "p6" -> "p7" [label="", id="edge_1", style="dashed", color="grey"]
    "p1" -> "r1" [label="bw0: Default '?2", id="edge_2", color="orange", edgetooltip=""]
    "p5" -> "p6" [label="", id="edge_3", color="green", edgetooltip=""]
    "p1" -> "p5" [label="", id="edge_4", style="dashed", color="grey"]
    "p7" -> "r0" [label="bw2: Default '?4", id="edge_5", color="orange", edgetooltip=""]
    "r2" -> "p7" [label="", id="edge_6", color="green", edgetooltip=""]
    "r1" -> "p5" [label="", id="edge_7", color="green", edgetooltip=""]
    "p6" -> "r2" [label="bw1: Default '?3", id="edge_8", color="orange", edgetooltip=""]
    "p3" -> "p7" [label="", id="edge_9", color="green", edgetooltip=""]
}

