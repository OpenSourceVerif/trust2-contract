digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="U"]
"p2" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut U"]
"p3" [label=<<FONT FACE="courier">y: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?10 mut u32"]
"r0" [label=<y↓'?10>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?10 mut u32\
"]
"p4" [label=<<FONT FACE="courier">z: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?11 mut u32"]
"r1" [label=<z↓'?11>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?11 mut u32\
"]
"p5" [label=<<FONT FACE="courier">(*x).g</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
"r2" [label=<x↓'?9 before bb0[7]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut U\
"]
"p6" [label=<<FONT FACE="courier">*x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="U"]
"p7" [label=<<FONT FACE="courier">(*x).f</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
    "p6" -> "p5" [label="", id="edge_0", color="green", edgetooltip=""]
    "p6" -> "p7" [label="", id="edge_1", color="green", edgetooltip=""]
    "p1" -> "p6" [label="", id="edge_2", style="dashed", color="grey"]
    "p7" -> "r0" [label="bw1: Default '?3", id="edge_3", color="orange", edgetooltip=""]
    "p1" -> "r2" [label="bw0: Default '?2", id="edge_4", color="orange", edgetooltip=""]
    "p2" -> "p6" [label="", id="edge_5", color="green", edgetooltip=""]
    "p5" -> "r1" [label="bw2: Default '?4", id="edge_6", color="orange", edgetooltip=""]
    "r2" -> "p6" [label="", id="edge_7", color="green", edgetooltip=""]
}

