digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="T"]
"p2" [label=<<FONT FACE="courier">x: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?4 mut T"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p4" [label=<<FONT FACE="courier">_4: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p5" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="u32"]
}

