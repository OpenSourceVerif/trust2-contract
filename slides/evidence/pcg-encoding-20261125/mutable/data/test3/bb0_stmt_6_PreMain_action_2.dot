digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="T"]
"p2" [label=<<FONT FACE="courier">x: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?4 mut T"]
"r0" [label=<x↓'?4>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut T\
"]
"p3" [label=<<FONT FACE="courier">*x</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="T"]
"r1" [label=<x↓'?4 before bb0[6]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut T\
"]
    "p2" -> "p3" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "p3" [label="", id="edge_1", style="dashed", color="grey"]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_2", color="orange", edgetooltip=""]
    "r1" -> "p3" [label="", id="edge_3", color="green", edgetooltip=""]
}

