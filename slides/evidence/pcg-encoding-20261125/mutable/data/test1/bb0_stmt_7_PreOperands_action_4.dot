digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label=<<FONT FACE="courier">x: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?4 mut i32"]
"r0" [label=<x↓'?4>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut i32\
"]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_0", color="orange", edgetooltip=""]
}

