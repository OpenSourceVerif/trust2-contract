digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p2" [label=<<FONT FACE="courier">x: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?4 mut i32"]
"r0" [label=<x↓'?4 before bb0[6]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?4 mut i32\
"]
"p3" [label=<<FONT FACE="courier">*x: W</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
    "r0" -> "p3" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_1", color="orange", edgetooltip=""]
    "p1" -> "p3" [label="", id="edge_2", style="dashed", color="grey"]
    "p2" -> "p3" [label="", id="edge_3", color="green", edgetooltip=""]
}

