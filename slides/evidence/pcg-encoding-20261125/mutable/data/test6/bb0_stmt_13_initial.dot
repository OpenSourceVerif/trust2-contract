digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="U"]
"p2" [label=<<FONT FACE="courier">a.g</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="u32"]
"p3" [label=<<FONT FACE="courier">a.f</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="u32"]
"p4" [label=<<FONT FACE="courier">y: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut u32"]
"p5" [label=<<FONT FACE="courier">z: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut u32"]
"r0" [label=<z↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut u32\
"]
"p6" [label=<<FONT FACE="courier">y2: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?10 mut u32"]
"r1" [label=<y2↓'?10>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?10 mut u32\
"]
"r2" [label=<y↓'?8 before bb0[11]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut u32\
"]
"p7" [label=<<FONT FACE="courier">*y</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
    "r2" -> "p7" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "p3" [label="", id="edge_1"]
    "p7" -> "r1" [label="bw2: Default '?4", id="edge_2", color="orange", edgetooltip=""]
    "p3" -> "p7" [label="", id="edge_3", style="dashed", color="grey"]
    "p1" -> "p2" [label="", id="edge_4"]
    "p3" -> "r2" [label="bw0: Default '?2", id="edge_5", color="orange", edgetooltip=""]
    "p4" -> "p7" [label="", id="edge_6", color="green", edgetooltip=""]
    "p2" -> "r0" [label="bw1: Default '?3", id="edge_7", color="orange", edgetooltip=""]
}

