digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="U"]
"p2" [label=<<FONT FACE="courier">a.g</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="u32"]
"p3" [label=<<FONT FACE="courier">a.f</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="u32"]
"p4" [label=<<FONT FACE="courier">y: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 mut u32"]
"r0" [label=<y↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 mut u32\
"]
"p5" [label=<<FONT FACE="courier">z: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?9 mut u32"]
"r1" [label=<z↓'?9>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?9 mut u32\
"]
    "p1" -> "p3" [label="", id="edge_0"]
    "p1" -> "p2" [label="", id="edge_1"]
    "p3" -> "r0" [label="bw0: Default '?2", id="edge_2", color="orange", edgetooltip=""]
    "p2" -> "r1" [label="bw1: Default '?3", id="edge_3", color="orange", edgetooltip=""]
}

