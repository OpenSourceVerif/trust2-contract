digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="U"]
"p2" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 mut u32"]
"p3" [label=<<FONT FACE="courier">z: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?9 mut u32"]
"p4" [label=<<FONT FACE="courier">y2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?10 mut u32"]
"p5" [label=<<FONT FACE="courier">z2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?11 mut u32"]
"p6" [label=<<FONT FACE="courier">_14: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="()"]
"p7" [label=<<FONT FACE="courier">_15: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="U"]
}

