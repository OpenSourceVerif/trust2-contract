digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 3_usize]"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p4" [label=<<FONT FACE="courier">_4: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?5 [i32]"]
"r0" [label=<_5↓'?5>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 [i32]\
"]
"p6" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 [i32; 3_usize]"]
"r1" [label=<_6 before bb0[6]↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 [i32; 3_usize]\
"]
    "p1" -> "r1" [label="bw0: shared '?2", id="edge_0", color="orange", edgetooltip=""]
    "r1" -> "r0" [label="Move with cast PointerCoercion(Unsize, Implicit)", id="edge_1", color="purple"]
}

