digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 3_usize]"]
"p2" [label=<<FONT FACE="courier">y: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 [i32]"]
"r0" [label=<y↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 [i32]\
"]
"p3" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p4" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p5" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p6" [label=<<FONT FACE="courier">_8: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p7" [label=<<FONT FACE="courier">_9: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p8" [label=<<FONT FACE="courier">_10: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"r1" [label=<_3 before bb0[5]↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 [i32; 3_usize]\
"]
"r2" [label=<_4 before bb0[9]↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 [i32; 3_usize]\
"]
"p9" [label=<<FONT FACE="courier">(*_4) before bb0[9]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="[i32; 3_usize]"]
"p10" [label=<<FONT FACE="courier">*y: R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="[i32]"]
"p11" [label=<<FONT FACE="courier">(*y)[_8]: R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"p12" [label=<<FONT FACE="courier">_4 before bb0[9]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?8 [i32; 3_usize]"]
    "r2" -> "p9" [label="", id="edge_0", color="green", edgetooltip=""]
    "r0" -> "p10" [label="", id="edge_1", color="green", edgetooltip=""]
    "p10" -> "p11" [label="", id="edge_2", color="green", edgetooltip=""]
    "p1" -> "p9" [label="", id="edge_3", style="dashed", color="grey"]
    "p12" -> "p9" [label="", id="edge_4", color="green", edgetooltip=""]
    "r1" -> "r0" [label="Move with cast PointerCoercion(Unsize, Implicit)", id="edge_5", color="purple"]
    "p2" -> "p10" [label="", id="edge_6", color="green", edgetooltip=""]
    "p9" -> "r1" [label="shared '?3", id="edge_7", color="orange", edgetooltip=""]
    "p1" -> "r2" [label="bw0: shared '?2", id="edge_8", color="orange", edgetooltip=""]
}

