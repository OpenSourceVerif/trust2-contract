digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 3_usize]"]
"p2" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 [i32]"]
"p3" [label=<<FONT FACE="courier">_3: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 [i32; 3_usize]"]
"r0" [label=<_3↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 [i32; 3_usize]\
"]
"p4" [label=<<FONT FACE="courier">_4: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?8 [i32; 3_usize]"]
"r1" [label=<_4↓'?8>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?8 [i32; 3_usize]\
"]
"p5" [label=<<FONT FACE="courier">_9: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="usize"]
"p6" [label=<<FONT FACE="courier">_10: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p7" [label=<<FONT FACE="courier">(*_4): R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="[i32; 3_usize]"]
    "r1" -> "p7" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "r1" [label="bw0: shared '?2", id="edge_1", color="orange", edgetooltip=""]
    "p7" -> "r0" [label="shared '?3", id="edge_2", color="orange", edgetooltip=""]
    "p1" -> "p7" [label="", id="edge_3", style="dashed", color="grey"]
    "p4" -> "p7" [label="", id="edge_4", color="green", edgetooltip=""]
}

