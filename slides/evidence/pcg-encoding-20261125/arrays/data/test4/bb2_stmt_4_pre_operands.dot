digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 3_usize]"]
"p2" [label=<<FONT FACE="courier">y: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?6 [i32]"]
"r0" [label=<y↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 [i32]\
"]
"p3" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="()"]
"p4" [label=<<FONT FACE="courier">_9: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">_10: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
}

