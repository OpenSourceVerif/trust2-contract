digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 3_usize]"]
"p2" [label=<<FONT FACE="courier">y: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 42_usize]"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p4" [label=<<FONT FACE="courier">_4: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p5" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="usize"]
"p6" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?13 [i32]"]
"p7" [label=<<FONT FACE="courier">_19: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p8" [label=<<FONT FACE="courier">_25: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p9" [label=<<FONT FACE="courier">_31: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p10" [label=<<FONT FACE="courier">_34: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p11" [label=<<FONT FACE="courier">_39: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p12" [label=<<FONT FACE="courier">_45: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"r0" [label=<_7 before bb0[12]↓'?14>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?14 [i32; 3_usize]\
"]
"r1" [label=<_6 before bb0[14]↓'?13>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?13 [i32]\
"]
    "p1" -> "r0" [label="bw0: shared '?2", id="edge_0", color="orange", edgetooltip=""]
    "r0" -> "r1" [label="Move with cast PointerCoercion(Unsize, Implicit)", id="edge_1", color="purple"]
}

