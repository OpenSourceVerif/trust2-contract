digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; N/#0]"]
"p2" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?5 [i32]"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?6 [i32; N/#0]"]
"p4" [label=<<FONT FACE="courier">_4: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?7 [i32; N/#0]"]
"r0" [label=<_4↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 [i32; N/#0]\
"]
"p5" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="usize"]
"p6" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
    "p1" -> "r0" [label="bw0: shared '?2", id="edge_0", color="orange", edgetooltip=""]
}

