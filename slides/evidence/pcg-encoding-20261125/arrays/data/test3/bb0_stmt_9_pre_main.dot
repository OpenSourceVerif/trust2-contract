digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; N/#0]"]
"p2" [label=<<FONT FACE="courier">y: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?5 [i32]"]
"r0" [label=<y↓'?5>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 [i32]\
"]
"p3" [label=<<FONT FACE="courier">_4: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 [i32; N/#0]"]
"p4" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"r1" [label=<_3 before bb0[5]↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 [i32; N/#0]\
"]
"r2" [label=<_4 before bb0[9]↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 [i32; N/#0]\
"]
"p6" [label=<<FONT FACE="courier">(*_4) before bb0[9]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="[i32; N/#0]"]
"p7" [label=<<FONT FACE="courier">_4: W before bb0[9]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 [i32; N/#0]"]
    "p7" -> "p6" [label="", id="edge_0", color="green", edgetooltip=""]
    "p1" -> "r2" [label="bw0: shared '?2", id="edge_1", color="orange", edgetooltip=""]
    "r1" -> "r0" [label="Move with cast PointerCoercion(Unsize, Implicit)", id="edge_2", color="purple"]
    "p1" -> "p6" [label="", id="edge_3", style="dashed", color="grey"]
    "r2" -> "p6" [label="", id="edge_4", color="green", edgetooltip=""]
    "p6" -> "r1" [label="shared '?3", id="edge_5", color="orange", edgetooltip=""]
}

