digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; N/#0]"]
"p2" [label=<<FONT FACE="courier">y: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?5 [i32]"]
"r0" [label=<y↓'?5>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 [i32]\
"]
"p3" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p4" [label=<<FONT FACE="courier">_6: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p6" [label=<<FONT FACE="courier">*y: R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="[i32]"]
"p7" [label=<<FONT FACE="courier">(*y)[_5]: R</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="i32"]
"r1" [label=<_4 before bb0[9]↓'?7>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 [i32; N/#0]\
"]
"p8" [label=<<FONT FACE="courier">(*_4) before bb0[9]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="[i32; N/#0]"]
"r2" [label=<_3 before bb0[5]↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 [i32; N/#0]\
"]
"p9" [label=<<FONT FACE="courier">_4 before bb0[9]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 [i32; N/#0]"]
    "p2" -> "p6" [label="", id="edge_0", color="green", edgetooltip=""]
    "p8" -> "r2" [label="shared '?3", id="edge_1", color="orange", edgetooltip=""]
    "p1" -> "p8" [label="", id="edge_2", style="dashed", color="grey"]
    "p9" -> "p8" [label="", id="edge_3", color="green", edgetooltip=""]
    "p1" -> "r1" [label="bw0: shared '?2", id="edge_4", color="orange", edgetooltip=""]
    "r0" -> "p6" [label="", id="edge_5", color="green", edgetooltip=""]
    "r2" -> "r0" [label="Move with cast PointerCoercion(Unsize, Implicit)", id="edge_6", color="purple"]
    "r1" -> "p8" [label="", id="edge_7", color="green", edgetooltip=""]
    "p6" -> "p7" [label="", id="edge_8", color="green", edgetooltip=""]
}

