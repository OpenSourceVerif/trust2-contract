digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p1" [label=<<FONT FACE="courier">x: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; N/#0]"]
"p2" [label=<<FONT FACE="courier">y: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?5 [i32]"]
"r0" [label=<y↓'?5>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?5 [i32]\
"]
"p3" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p4" [label=<<FONT FACE="courier">_6: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
}

