digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">x</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="[i32; 3_usize]"]
"p2" [label=<<FONT FACE="courier">y: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?5 mut [i32]"]
"p3" [label=<<FONT FACE="courier">_5: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p4" [label=<<FONT FACE="courier">_6: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="*const [i32]"]
"p5" [label=<<FONT FACE="courier">_7: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p6" [label=<<FONT FACE="courier">_8: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"r0" [label=<_4 before bb0[12]↓'?7 before bb0[7]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?7 mut [i32; 3_usize]\
"]
    "p1" -> "r0" [label="bw0: Default '?2", id="edge_0", color="orange", edgetooltip=""]
}

