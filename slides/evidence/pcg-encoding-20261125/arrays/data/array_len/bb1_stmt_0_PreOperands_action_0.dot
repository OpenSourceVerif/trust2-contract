digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">a: R</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="[i32; 5_usize]"]
"p2" [label=<<FONT FACE="courier">_2: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p4" [label=<<FONT FACE="courier">_4: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">_5: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?5 [i32]"]
"r0" [label=<_6 before bb0[9]↓'?6>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?6 [i32; 5_usize]\
"]
    "p1" -> "r0" [label="bw0: shared '?2", id="edge_0", color="orange", edgetooltip=""]
}

