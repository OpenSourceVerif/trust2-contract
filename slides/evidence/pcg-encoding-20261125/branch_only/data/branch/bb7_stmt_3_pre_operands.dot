digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p1" [label=<<FONT FACE="courier">flag: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="bool"]
"p2" [label=<<FONT FACE="courier">a: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p3" [label=<<FONT FACE="courier">b: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="i32"]
"p4" [label=<<FONT FACE="courier">r: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?7 mut i32"]
"p5" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p6" [label=<<FONT FACE="courier">_12: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p7" [label=<<FONT FACE="courier">_13: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="bool"]
"p8" [label=<<FONT FACE="courier">_14: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="i32"]
}

