    "r2" -> "p11" [label="", id="edge_5", color="green", edgetooltip="bb2 -> bb9"]
    "p12" -> "p15" [label="", id="edge_6", color="green", edgetooltip="bb2 -> bb9"]
    "p11" -> "r3" [label="bw4: Default '?8", id="edge_7", color="orange", edgetooltip="bb2 -> bb9"]
