"p8" [label=<<FONT FACE="courier">_19: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="!"]
"p9" [label=<<FONT FACE="courier">_20: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?17 mut u32"]
"r0" [label=<Remote(_1)↓'?11>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?11 mut List\
"]
"r1" [label=<current before bb9[10]↓'?13 before bb9[8]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?13 mut List\
"]
"p10" [label=<<FONT FACE="courier">(*current).head before bb9[10]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
"r2" [label=<_20↓'?17 before bb9[9]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?17 mut u32\
"]
"p11" [label=<<FONT FACE="courier">(*_20)</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
"p12" [label=<<FONT FACE="courier">*current before bb9[10]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="List"]
"p13" [label=<<FONT FACE="courier">current before bb9[10]</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?13 mut List"]
"p14" [label=<<FONT FACE="courier">(*_3): E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
"r3" [label=<_3↓'?12 before bb9[12]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?12 mut u32\
"]
"p15" [label=<<FONT FACE="courier">(*current).tail before bb9[10]</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="std::option::Option<std::boxed::Box<List, std::alloc::Global>>"]
    "p13" -> "p12" [label="", id="edge_0", color="green", edgetooltip="bb2 -> bb9"]
    "r3" -> "p14" [label="", id="edge_1", color="green", edgetooltip="bb2 -> bb9"]
    "p10" -> "r2" [label="bw3: Default '?7", id="edge_2", color="orange", edgetooltip="bb2 -> bb9"]
    "p10" -> "p11" [label="", id="edge_3", style="dashed", color="grey"]
