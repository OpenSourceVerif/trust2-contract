digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?10 mut u32"]
"p1" [label=<<FONT FACE="courier">self: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?11 mut List"]
"p2" [label=<<FONT FACE="courier">n: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p3" [label=<<FONT FACE="courier">_3: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?12 mut u32"]
