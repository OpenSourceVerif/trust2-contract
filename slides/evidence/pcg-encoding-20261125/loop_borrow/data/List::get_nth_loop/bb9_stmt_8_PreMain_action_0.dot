digraph "graph" {
layout=dot
node [shape=rect]
"p0" [label=<<FONT FACE="courier">RETURN: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?10 mut u32"]
"p1" [label=<<FONT FACE="courier">self: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?11 mut List"]
"p2" [label=<<FONT FACE="courier">n: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p3" [label=<<FONT FACE="courier">_3: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?12 mut u32"]
"p4" [label=<<FONT FACE="courier">i: E</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="usize"]
"p5" [label=<<FONT FACE="courier">current: e</FONT>>, fontcolor="black", color="black", shape="rect", tooltip="&'?13 mut List"]
"p6" [label=<<FONT FACE="courier">_7: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="()"]
"p7" [label=<<FONT FACE="courier">_13: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="isize"]
"p8" [label=<<FONT FACE="courier">_16: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="(usize, bool)"]
"p9" [label=<<FONT FACE="courier">_17: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="!"]
"p10" [label=<<FONT FACE="courier">_19: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="!"]
"p11" [label=<<FONT FACE="courier">_20: W</FONT>>, fontcolor="gray", color="gray", shape="rect", tooltip="&'?17 mut u32"]
"r0" [label=<Remote(_1)↓'?11>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?11 mut List\
"]
"r1" [label=<current↓'?13 before bb9[8]>, fontcolor="blue", color="blue", shape="octagon", tooltip="&'?13 mut List\
"]
"p12" [label=<<FONT FACE="courier">*current</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="List"]
"p13" [label=<<FONT FACE="courier">(*current).head</FONT>>, fontcolor="gray", color="gray", shape="rect", style="rounded", penwidth=1.5, tooltip="u32"]
"p14" [label=<<FONT FACE="courier">(*current).tail: E</FONT>>, fontcolor="darkgreen", color="darkgreen", shape="rect", style="rounded", penwidth=1.5, tooltip="std::option::Option<std::boxed::Box<List, std::alloc::Global>>"]
    "p12" -> "p14" [label="", id="edge_0", color="green", edgetooltip="bb2 -> bb9"]
    "r0" -> "r1" [label="loop at bb1[0]", id="edge_1", penwidth="3"]
    "p5" -> "p12" [label="", id="edge_2", color="green", edgetooltip="bb2 -> bb9"]
    "p12" -> "p13" [label="", id="edge_3", color="green", edgetooltip="bb2 -> bb9"]
    "r1" -> "p12" [label="", id="edge_4", color="green", edgetooltip="bb2 -> bb9"]
}

