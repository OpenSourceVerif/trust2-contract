module I128
  use bv.BV128 as BV
  use int.Int as Int
  use int.ComputerDivision as Computer
  use int.EuclideanDivision as Euclidean
  use bv.BV8 as BV8

  type t = BV.t

  type t_ = <range -0x8000_0000_0000_0000_0000_0000_0000_0000 0x7FFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF>

  clone mach.int.Bounded_int as BoundedInt with
    type t = t_,
    constant min = t_'minInt,
    constant max = t_'maxInt,
    function to_int = t_'int,
    lemma to_int_in_bounds,
    lemma extensionality

  let function of_int = BV.of_int
  let function to_int = BV.to_int

  let function add_strict (a : t) (b : t) : t
  = of_int BoundedInt.(to_int (of_int (to_int a) + of_int (to_int b)))
  let function sub_strict (a : t) (b : t) : t
  = of_int BoundedInt.(to_int (of_int (to_int a) - of_int (to_int b)))
  let function mul_strict (a : t) (b : t) : t
  = of_int BoundedInt.(to_int (of_int (to_int a) * of_int (to_int b)))
  let function div_strict (a : t) (b : t) : t
  = of_int BoundedInt.(to_int (of_int (to_int a) / of_int (to_int b)))
  let function rem_strict (a : t) (b : t) : t
    requires { [@expl:division by zero] to_int b <> 0 }
    requires { [@expl:integer overflow] BoundedInt.in_bounds (Computer.mod (to_int a) (to_int b)) }
    requires { not (to_int a = t_'minInt /\ b = BV.ones) }
  = of_int BoundedInt.(to_int (of_int (to_int a) % of_int (to_int b)))

  let function add_wrapping = BV.add
  let function sub_wrapping = BV.sub
  let function mul_wrapping = BV.mul

  val function add_overflowing (a : t) (b : t) : (t, bool)
    ensures { result = (add_wrapping a b, not BoundedInt.in_bounds Int.(to_int a + to_int b)) }
  val function sub_overflowing (a : t) (b : t) : (t, bool)
    ensures { result = (sub_wrapping a b, not BoundedInt.in_bounds Int.(to_int a - to_int b)) }
  val function mul_overflowing (a : t) (b : t) : (t, bool)
    ensures { result = (mul_wrapping a b, not BoundedInt.in_bounds Int.(to_int a * to_int b)) }

  val (=) (a : t) (b : t) : bool
    ensures { result <-> a = b }
  let function (<) (a : t) (b : t) : bool
  = Int.(to_int a < to_int b)
  let function (<=) (a : t) (b : t) : bool
  = Int.(to_int a <= to_int b)
  let function (>) (a : t) (b : t) : bool
  = Int.(to_int a > to_int b)
  let function (>=) (a : t) (b : t) : bool
  = Int.(to_int a >= to_int b)

  let function bit_xor = BV.bw_xor
  let function bit_and = BV.bw_and
  let function bit_or = BV.bw_or

  let function shl_strict (a : t) (b : int) : t
    requires { Int.(0 <= b < BV.size) }
  = BV.lsl a b
  let function shr_strict (a : t) (b : int) : t
    requires { Int.(0 <= b < BV.size) }
  = BV.asr a b

  val function shl_unbounded (a : t) (b : int) : t
    ensures { result = BV.lsl a (Euclidean.mod b BV.size) }
  val function shr_unbounded (a : t) (b : int) : t
    ensures { result = BV.asr a (Euclidean.mod b BV.size) }

  val function cmp (a : t) (b : t) : BV8.t
    ensures { result = if a < b then BV8.ones else if a = b then BV8.zeros else BV8.one }

  let function bit_not = BV.bw_not

  let function neg = BV.neg
end
