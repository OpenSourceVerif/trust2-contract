#!/bin/sh

set -e

cd $(git rev-parse --show-toplevel)

# `cargo clippy` runs `cargo check`, which may produce warnings.
cargo clippy --all-targets --all-features -- --no-deps -D warnings
for dir in \
    charon/charon \
    cargo-verify/tests/end-to-end/* \
    examples/* \
; do
    if [ -d "$dir" ]; then
        (
            cd "$dir"
            cargo clippy --all-targets --all-features -- -D warnings
        )
    fi
done

for dir in \
    . \
    proc-macro-crate \
    charon/charon \
    cargo-verify/tests/end-to-end/* \
    examples/* \
; do
    if [ -d "$dir" ]; then
        (
            cd "$dir"
            cargo fmt --check
        )
    fi
done
